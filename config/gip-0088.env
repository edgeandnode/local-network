# GIP-0088 overlay fragment — switches the contract image to a post-audit
# build (issuance + deployment packages present) and enables Phase 3 in
# containers/core/graph-contracts/run.sh: deploys REO, IssuanceAllocator,
# RecurringAgreementManager; runs activation goals; grants ORACLE_ROLE;
# sets eligibility validation + period + timeout.
#
# Layer this AFTER services.env. Recipes: gip-0088, indexing-payments,
# reo-live.

# sha-4140439 = contracts main @ 414043938 (post-audit-chain merge).
CONTRACTS_VERSION=sha-4140439
GIP0088_ENABLED=1

# eligibilityPeriod: how long an indexer stays eligible after renewal (seconds).
REO_ELIGIBILITY_PERIOD=300
# oracleUpdateTimeout: fail-safe — if no oracle update for this long, all
# indexers eligible (seconds).
REO_ORACLE_UPDATE_TIMEOUT=86400
