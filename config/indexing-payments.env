# Indexing-payments overlay — turns the baseline into the FULL on-chain DIPs
# lifecycle stack. Compose this fragment AFTER services.env so its values win.
#
# What this overlay turns on:
#   - indexer-rs (service + tap-agent) on its DIPs-merged main, which parses
#     the [dips] config schema in indexer-service/run.sh.
#   - The DIPs-capable indexer-agent (main-dips), which when --enable-dips is
#     set reads RecurringCollector agreements from the indexing-payments
#     subgraph and accepts/collects them ON-CHAIN. The agent run.sh exports
#     INDEXER_AGENT_ENABLE_DIPS=true gated on INDEXING_PAYMENTS_ENABLED below.
#   - The indexing-payments profile services: dipper (submits offers on-chain
#     + consumes signals from the `indexing-requirements` Redpanda topic),
#     IISA, and the indexing-payments subgraph (Offer / IndexingAgreement).

# Gate the [dips] section in indexer-service config.toml AND --enable-dips in
# the indexer-agent. Off by default in services.env (upstream v2.1.0 indexer-rs
# would fail to parse [dips], and the baseline agent image lacks --enable-dips).
INDEXING_PAYMENTS_ENABLED=1

# --- DIPs component image set (coherent full-lifecycle set) ---
# indexer-agent: DIPs build from main-dips (rebased onto main) — has
# --enable-dips + on-chain accept/collect. Not published by CI (CI builds
# main only), so consumed as the locally-built `:local` tag. See README.
INDEXER_AGENT_VERSION=local
# indexer-rs (service + tap): DIPs build, consumed as the locally-built
# `:local` tag (coherent with the locally-built agent + dipper). DIPs is also
# merged to indexer-rs main if a published pin is preferred (e.g. sha-b8a5b04).
INDEXER_SERVICE_RS_VERSION=local
INDEXER_TAP_AGENT_VERSION=local
# dipper: locally-built `:local` (has the on-chain RecurringCollector.offer
# path AND the Redpanda `indexing-requirements` signal consumer). Not published.
DIPPER_VERSION=local
IISA_VERSION=v2.3.1
# Subgraph: locally-built `:local` from mb9/add-recurring-collector-offer-entity
# (has the RecurringCollector Offer entity + IndexingAgreement.canceledBy /
# lastStateChangeBlock that the current dipper chain_listener queries). main
# (sha-a58543a) is too old — dipper errors "no field canceledBy".
INDEXING_PAYMENTS_SUBGRAPH_VERSION=local
