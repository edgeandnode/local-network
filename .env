INDEXER_SERVICE_BINARY=/Users/samuel/Documents/github/indexer-rs/target/release/indexer-service-rs
TAP_AGENT_BINARY=/Users/samuel/Documents/github/indexer-rs/target/release/indexer-tap-agent

